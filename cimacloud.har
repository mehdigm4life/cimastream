nt:center;background:rgba(0,0,0,.45)}\n#uqcs-box .uqcs-card{position:relative;display:block;line-height:0;width:300px;max-width:86vw;box-shadow:0 6px 24px rgba(0,0,0,.6);border-radius:6px;cursor:pointer}\n#uqcs-box .uqcs-card .uqp{display:block;width:100%;aspect-ratio:300/250;max-height:84vh;background:center/contain no-repeat;border-radius:6px}\n#uqcs-box .uqcs-x{top:-8px;right:-8px}\n</style>\n<a id=\"uqcs-bar\" style=\"display:none;text-decoration:none\" target=\"_blank\" rel=\"noopener\"></a>\n<div id=\"uqcs-box\"></div>\n<script>\n(function(){\n  try{\n    var URL='/i2/q/go.html';   // first-party hop -> Linebet tracking link (filter lists hide <a href*=lb-aff.com>)\n    var CC='MA', CODE='UQEARN';\n    var L={\n      en:['Sports betting & casino','Promo code','Sign up'],\n      fr:['Paris sportifs & casino','Code promo','Inscription'],\n      es:['Apuestas deportivas y casino','Código promo','Regístrate'],\n      pt:['Apostas esportivas e cassino','Código promo','Cadastre-se'],\n      ar:['رهانات رياضية وكازينو','كود البونص','سجّل الآن']\n    };\n    var lang=((navigator.language||'en').slice(0,2)).toLowerCase(); var t=L[lang]||L.en;\n    function ev(n,slot){ try{ if(window.plausible) window.plausible(n,{props:{cc:CC,slot:slot}}); }catch(e){} }\n    function go(slot){ ev('Casino Click',slot); }\n    var bar=document.getElementById('uqcs-bar'), box=document.getElementById('uqcs-box'); bar.href=URL;\n    if(lang==='ar'){ bar.dir='rtl'; box.dir='rtl'; }\n    var IMG='/i2/q/';   // first-party, neutral names (filter lists match 'banner'/'728x90' in URLs)\n    var wide=(window.innerWidth||document.documentElement.clientWidth||0)>=740;\n    bar.innerHTML='<span class=\"uqp'+(wide?'':' m')+'\" style=\"background-image:url('+IMG+(wide?'w':'m')+'.jpg)\"></span><span class=\"uqcs-x\" title=\"Close\">\\u00d7</span>';\n    box.innerHTML='<a class=\"uqcs-card\" style=\"text-decoration:none\" target=\"_blank\" rel=\"noopener\" href=\"'+URL+'\"><span class=\"uqcs-x\" title=\"Close\">\\u00d7</span><span class=\"uqp\" style=\"background-image:url('+IMG+'s.jpg)\"></span></a>';\n    var barClosed=false, played=false, boxShown=0;\n    bar.style.display='block'; ev('Casino Impression','bar');\n    // 2026-10-06: pop networks (now ProfitON on the first click) listen on window/document and may lay an invisible\n    // cover over the page, so they were stealing clicks meant for the casino banner. This script runs BEFORE the async\n    // pop scripts register, so our window-level capture listeners fire first: a press that lands on the strip or the\n    // pause card (hit-tested by coordinates, so it works even through a cover) is stopped here and never reaches the pops.\n    function hit(el,x,y){ if(!el) return false; var r=el.getBoundingClientRect(); return r.width>0 && x>=r.left && x<=r.right && y>=r.top && y<=r.bottom; }\n    function zone(e){\n      var p=(e.touches&&e.touches[0])||(e.changedTouches&&e.changedTouches[0])||e, x=p.clientX, y=p.clientY;\n      if(x==null) return null;\n      if(box.style.display==='flex'){ var card=box.firstChild;\n        if(hit(card.querySelector('.uqcs-x'),x,y)) return 'boxclose';\n        if(hit(card,x,y)) return 'box';\n        return 'boxout'; }\n      if(bar.style.display!=='none'){\n        if(hit(bar.querySelector('.uqcs-x'),x,y)) return 'barclose';\n        if(hit(bar,x,y)) return 'bar'; }\n      return null;\n    }\n    ['pointerdown','mousedown','touchstart','pointerup','mouseup','touchend'].forEach(function(tp){\n      window.addEventListener(tp,function(e){ var z=zone(e); if(z && z!=='boxout') e.stopImmediatePropagation(); },true);\n    });\n    window.addEventListener('click',function(e){\n      var z=zone(e); if(!z) return;\n      if(z==='boxout'){ box.style.display='none'; return; }          // outside the card: close it, let the click go on (pops/player)\n      e.stopImmediatePropagation();\n      if(z==='barclose'){ e.preventDefault(); bar.style.display='none'; barClosed=true; return; }\n      if(z==='boxclose'){ e.preventDefault(); box.style.display='none'; try{ if(window.jwplayer && jwplayer().play) jwplayer().play(); }catch(x){} return; }\n      go(z==='bar'?'bar':'pause');\n      var a=e.target && e.target.closest ? e.target.closest('a') : null;\n      if(!(a && (bar.contains(a)||box.contains(a)))){ e.preventDefault(); try{ window.open(URL,'_blank','noopener'); }catch(x){} }   // a cover took the click: open it ourselves\n      if(z==='box') setTimeout(function(){ box.style.display='none'; },50);\n    },true);\n    // media events do not bubble - capture on document catches the player's <video>\n    var barTimer=null;\n    document.addEventListener('playing',function(){\n      played=true; box.style.display='none';\n      // 2026-10-07 owner: strip stays until the viewer closes it with the X (no auto-hide; the 20 s timer was removed)\n      if(!barClosed) bar.style.display='block';\n    },true);\n    document.addEventListener('pause',function(ev2){\n      try{\n        return;   // 2026-10-07 owner: pause card REMOVED (Linebet: ~10k clicks/day, 0 registrations -> mostly accidental taps on resume). Delete this line to restore.\n        var v=ev2.target; if(!played || !v || v.ended || v.seeking) return;\n        if(boxShown>=3) return;   // cap per page load\n        setTimeout(function(){ if(v.paused && !v.ended){ bar.style.display='none'; box.style.display='flex'; boxShown++; ev('Casino Impression','pause'); } },400);\n      }catch(x){}\n    },true);\n  }catch(e){}\n})();\n</script>\n\n\n\n\n\t<!-- 2026-10-06 ad-block wall (WALL=1). Every page also reports what each probe found (Plausible \"Adblock Probe\").\n     ?adbdebug=1 shows a results panel (and still shows the wall). Not included at all when the page has no ad tags.\n     Probes: bait  = first-party /ad/pop.adsbox.js did not run (window.cRAds unset)\n             elem  = ad-classed bait box collapsed by cosmetic filters\n             google= no-cors fetch of Google's ad script rejected (Brave Shields / uBlock / Pi-hole)\n             adfail/adok = ad-network script tags that errored / loaded (window capture listeners, set before the ad tags) -->\n<style>\n#uqab149670{display:none;position:fixed;inset:0;z-index:2147483647;background:#000;color:#fff;\n font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;text-align:center;align-items:center;justify-content:center;padding:16px;box-sizing:border-box}\n#uqab149670 .lk{font-size:34px;line-height:1;margin-bottom:10px}\n#uqab149670 h2{margin:0 0 8px;font-size:20px;font-weight:800;color:#fff!important}\n#uqab149670 p{margin:0 auto 14px;max-width:420px;font-size:13px;line-height:1.45;font-weight:500;color:#ddd!important}\n#uqab149670 button{background:#00ADEF;color:#fff;border:0;border-radius:6px;padding:7px 18px;font-size:13px;font-weight:700;cursor:pointer}\n#uqabdbg{position:fixed;left:8px;bottom:8px;z-index:2147483647;background:rgba(0,0,0,.85);color:#0f0;font:12px/1.45 monospace;padding:8px 10px;border-radius:6px;max-width:94vw;white-space:pre-wrap}\n@media (max-height:300px){#uqab149670 .lk{font-size:22px;margin-bottom:4px}#uqab149670 h2{font-size:15px;margin-bottom:4px}#uqab149670 p{font-size:11px;margin-bottom:8px}}\n</style>\n<script>\n(function(){\n  var WALL = 0;   // 2026-10-06 21:5x local: SILENT per owner (wall cost ~35% of mainstream plays); was ON 19:30-21:5x (rule validated: ABP/uBO via google/elem/bait, Brave via navigator.brave + our ad scripts blocked)\n  var ON = 1;\n  var DEBUG = /[?&]adbdebug=1/.test(location.search);\n  var REF = 'uqload.vc' || 'direct';\n  var LS='uqab_walled';\n  function ev(n,props){ try{ if(window.plausible) window.plausible(n,{props:props}); }catch(e){} }\n  function lsGet(){ try{ return localStorage.getItem(LS); }catch(e){ return null; } }\n  function lsSet(v){ try{ if(v) localStorage.setItem(LS,v); else localStorage.removeItem(LS); }catch(e){} }\n  var AD = /buzukiabateful|heatenpyropus|4xfreedom|benchform|mayhemsrewind|runative-syndic