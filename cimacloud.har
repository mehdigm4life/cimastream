s = (R.brave==='yes' && nf>=1);\n    // 10-06: uBlock Origin (Firefox) passes google (surrogate redirect) + bait box but blocks our ad scripts. Logged only for now:\n    var adsOnlyBlocked = (R.brave!=='yes' && nf>=1 && nok===0 && R.net==='ok');\n    var blocked = (R.google==='blocked') || (R.elem==='hidden') || (R.bait==='blocked') || braveShields;\n    return {blocked:blocked, nf:nf, nok:nok, brave:braveShields, adsonly:adsOnlyBlocked};\n  }\n  // decide as soon as any probe is conclusive, so the wall is up before the viewer can start the video\n  // instant probes (google/elem/bait) decide at once; the Brave rule waits until 2.5 s so the other ad scripts had a chance to load\n  // (an ad network briefly down must never wall a Brave user whose Shields are off)\n  // window.adbon is what the player's op=view ping reports (JW8.pm: adb=1) -> Views.adb -> payout rule m5 (adb_money_percent)\n  function early(){ try{ var v=verdict(); if(v.blocked && !v.brave){ window.adbon=1; show('adblock'); } }catch(e){} }\n  setTimeout(function(){ try{ var v=verdict(); if(v.blocked){ window.adbon=1; show(v.brave?'brave':'adblock'); } }catch(e){} }, 2500);\n  function report(){\n    if(reported) return; reported=true;\n    var v=verdict();\n    try{ if(window.plausible) window.plausible('Adblock Probe',{props:{blocked:String(v.blocked),google:R.google,elem:R.elem,bait:R.bait,brave:R.brave,net:R.net,adsonly:String(v.adsonly&&!v.blocked),adfail:String(v.nf),adok:String(v.nok)}}); }catch(e){}\n    if(DEBUG){\n      var p=document.createElement('div'); p.id='uqabdbg';\n      p.textContent='AD-BLOCK DEBUG\\n google fetch : '+R.google+'\\n bait element : '+R.elem+'\\n bait script  : '+R.bait+'\\n brave browser: '+R.brave+'\\n neutral net  : '+R.net+\n        '\\n ad scripts failed: '+(Object.keys(R.adfail).join(', ')||'none')+'\\n ad scripts loaded: '+(Object.keys(R.adok).join(', ')||'none')+\n        '\\n => verdict: '+(v.blocked?('AD BLOCKER'+(v.brave?' (Brave Shields)':'')):'clean')+(v.adsonly&&!v.blocked?'  [ads-only block: would be walled by the uBlock rule]':'')+'   (wall '+(WALL?'ON':'off')+', page eligible '+(ON?'yes':'no')+')';\n      (document.body||document.documentElement).appendChild(p);\n    }\n    if(v.blocked){ window.adbon=1; show(v.brave?'brave':'adblock'); }\n    else if(ON){ var prev=lsGet(); if(prev){ ev('Adblock Disabled',{site:REF, was:(prev.split('|')[1]||'?')}); lsSet(null); } }\n  }\n  function probes(){\n    try{\n      if(window.fetch){\n        var to=setTimeout(function(){ if(R.google==='?') R.google='timeout'; },5000);\n        fetch('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js',{mode:'no-cors',cache:'no-store',credentials:'omit'})\n          .then(function(){ clearTimeout(to); R.google='ok'; })\n          .catch(function(){ clearTimeout(to); R.google='blocked'; early(); });\n      } else R.google='n/a';\n    }catch(e){ R.google='err'; }\n    try{\n      if(window.fetch){\n        var to2=setTimeout(function(){ if(R.net==='?') R.net='timeout'; },5000);\n        fetch('https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js?uq='+Date.now(),{mode:'no-cors',cache:'no-store',credentials:'omit'})\n          .then(function(){ clearTimeout(to2); R.net='ok'; }).catch(function(){ clearTimeout(to2); R.net='fail'; });\n      } else R.net='n/a';\n    }catch(e){ R.net='err'; }\n    try{\n      var b=document.createElement('div');\n      b.className='adsbox ad-banner pub_300x250 pub_728x90 text-ad textAd text_ad adsbygoogle';\n      b.setAttribute('style','position:absolute;left:-9999px;top:-9999px;width:300px;height:250px;');\n      b.innerHTML='&nbsp;';\n      (document.body||document.documentElement).appendChild(b);\n      setTimeout(function(){\n        try{ var cs=getComputedStyle(b); R.elem=(b.offsetHeight===0 || cs.display==='none' || cs.visibility==='hidden') ? 'hidden' : 'visible'; early(); }catch(e){ R.elem='err'; }\n        try{ b.parentNode && b.parentNode.removeChild(b); }catch(e){}\n      },4